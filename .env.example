# Copy to .env and fill in values (never commit .env)

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI — at least one required for summaries/chat
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# Speech-to-text (use one)
EXPO_PUBLIC_OPENAI_API_KEY=your-openai-key
EXPO_PUBLIC_DEEPGRAM_API_KEY=your-deepgram-key
EXPO_PUBLIC_TRANSCRIPTION_PROVIDER=openai

# Optional native SDK keys (configure when enabling)
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
